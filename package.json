{
  "name": "mandate-api",
  "version": "0.4.0",
  "private": true,
  "description": "Delegated authorization, approval gates, and signed action receipts for AI agents.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker:attempt-expiry": "node scripts/run-action-attempt-expiry.js",
    "worker:outbox": "node scripts/run-outbox-worker.js",
    "outbox:dead-letter:list": "node scripts/list-outbox-dead-letters.js",
    "outbox:dead-letter:replay": "node scripts/replay-outbox-dead-letter.js",
    "idempotency:cleanup": "node scripts/cleanup-idempotency.js",
    "database:roles": "node scripts/configure-database-roles.js",
    "database:backup": "node scripts/backup-database.js",
    "database:restore-drill": "node scripts/restore-database-drill.js",
    "package:receipt-verifier": "node scripts/package-receipt-verifier.js",
    "test": "node --test",
    "check": "npm run check:syntax && node --test",
    "check:syntax": "node scripts/check-syntax.js",
    "migrate": "node scripts/migrate.js",
    "test:postgres": "node --test --test-concurrency=1 test/postgres-*.test.js"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "pg": "8.22.0"
  }
}
