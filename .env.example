PORT=8787
MANDATE_STORE=memory
MANDATE_API_KEY=replace-with-a-long-random-secret
# Container deployments may set MANDATE_API_KEY_FILE instead. Never set both.
MANDATE_API_KEY_FILE=
MANDATE_API_CREDENTIAL_ID=key_runtime
MANDATE_API_CREDENTIAL_NAME=Runtime bootstrap credential
MANDATE_TENANT_ID=ten_local
MANDATE_TENANT_NAME=Local tenant
MANDATE_ENVIRONMENT=test
# Comma-separated. Wildcard is local/test only.
MANDATE_API_SCOPES=*

# PostgreSQL mode. Run `npm run migrate` with the deployment role before starting services.
DATABASE_URL=postgresql://mandate:mandate@localhost:5432/mandate
# Container deployments may set DATABASE_URL_FILE instead. Never set both.
DATABASE_URL_FILE=
MANDATE_DATABASE_POOL_MAX=10
MANDATE_TRANSACTION_ATTEMPTS=4
MANDATE_DATABASE_SSL=false
MANDATE_API_READINESS_TIMEOUT_MS=2000

# Explicit least-privilege roles configured by `npm run database:roles` after migrations.
MANDATE_DATABASE_API_ROLE=mandate_api
MANDATE_DATABASE_EXPIRY_ROLE=mandate_expiry_worker
MANDATE_DATABASE_OUTBOX_ROLE=mandate_outbox_worker
MANDATE_DATABASE_MAINTENANCE_ROLE=mandate_maintenance
MANDATE_DATABASE_OPERATOR_ROLE=mandate_operator

# Optional in test mode. Live API mode requires persistent PEM values and an explicit key ID.
MANDATE_PRIVATE_KEY_PEM=
MANDATE_PUBLIC_KEY_PEM=
# Container deployments may use the corresponding secret files. Never set direct and file values together.
MANDATE_PRIVATE_KEY_PEM_FILE=
MANDATE_PUBLIC_KEY_PEM_FILE=
MANDATE_KEY_ID=local-dev-ed25519

# Dedicated action-attempt expiry worker. It does not use MANDATE_API_KEY and never applies migrations.
MANDATE_EXPIRY_WORKER_ID=expiry-worker-local-01
MANDATE_EXPIRY_POLL_INTERVAL_MS=1000
MANDATE_EXPIRY_BATCH_LIMIT=100
MANDATE_EXPIRY_READINESS_STALE_MS=5000
MANDATE_EXPIRY_READINESS_FAILURE_THRESHOLD=3
# Loopback by default. Expose through deployment network policy only when required.
MANDATE_EXPIRY_HEALTH_HOST=127.0.0.1
MANDATE_EXPIRY_HEALTH_PORT=8788

# Dedicated outbox worker. The handler module is trusted local deployment code.
MANDATE_OUTBOX_HANDLER_MODULE=./deployment/outbox-handlers.js
MANDATE_OUTBOX_WORKER_ID=outbox-worker-local-01
MANDATE_OUTBOX_POLL_INTERVAL_MS=1000
MANDATE_OUTBOX_CYCLE_LIMIT=100
MANDATE_OUTBOX_LEASE_MS=30000
MANDATE_OUTBOX_MAX_ATTEMPTS=5
MANDATE_OUTBOX_BASE_DELAY_MS=1000
MANDATE_OUTBOX_MAXIMUM_DELAY_MS=60000
MANDATE_OUTBOX_READINESS_STALE_MS=5000
MANDATE_OUTBOX_READINESS_FAILURE_THRESHOLD=3
# Loopback by default. Expose through deployment network policy only when required.
MANDATE_OUTBOX_HEALTH_HOST=127.0.0.1
MANDATE_OUTBOX_HEALTH_PORT=8789

# Controlled dead-letter inspection and replay. Replay requires every value below.
MANDATE_OUTBOX_EVENT_TYPES=
MANDATE_OUTBOX_DEAD_LETTER_LIMIT=100
MANDATE_OUTBOX_MESSAGE_ID=
MANDATE_OUTBOX_EXPECTED_ATTEMPT_COUNT=
MANDATE_OPERATOR_ID=
MANDATE_OUTBOX_REPLAY_REASON=
MANDATE_OUTBOX_REPLAY_IDEMPOTENCY_KEY=
MANDATE_REQUEST_ID=

# One-shot idempotency replay cleanup. Seven days is the minimum supported retention window.
MANDATE_IDEMPOTENCY_RETENTION_SECONDS=604800
MANDATE_IDEMPOTENCY_CLEANUP_BATCH_LIMIT=500
MANDATE_IDEMPOTENCY_CLEANUP_MAX_BATCHES=20
